{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "task.saveBeforeRun": "always",
  "dotnet.preferCSharpExtension": true,
  "c-cpp-compile-run.cpp-compiler": "g++",
  "c-cpp-compile-run.cpp-flags": "-std=c++17 -Wall -Wextra -Wpedantic -g",
  "c-cpp-compile-run.save-before-compile": true,
  "c-cpp-compile-run.output-location": "${workspaceFolder}/build",
  "c-cpp-compile-run.mirror-output-location": true,
  "c-cpp-compile-run.run-in-external-terminal": false,
  "c-cpp-compile-run.skip-if-compiled": false,
  "code-runner.executorMapByFileExtension": {
    ".cpp": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run-cpp.ps1\" -Source \"$fullFileName\"",
    ".cc": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run-cpp.ps1\" -Source \"$fullFileName\"",
    ".cxx": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run-cpp.ps1\" -Source \"$fullFileName\"",
    ".c++": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$workspaceRoot\\scripts\\run-cpp.ps1\" -Source \"$fullFileName\""
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.preserveFocus": false,
  "C_Cpp.formatting": "vcFormat",
  "C_Cpp.autocompleteAddParentheses": true,
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.namespace": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.type": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.function": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.block": "newLine",
  "C_Cpp.vcFormat.newLine.beforeOpenBrace.lambda": "newLine",
  "C_Cpp.vcFormat.newLine.beforeElse": true,
  "C_Cpp.vcFormat.newLine.beforeCatch": true,
  "C_Cpp.vcFormat.indent.braces": false,
  "C_Cpp.vcFormat.indent.caseLabels": false,
  "C_Cpp.vcFormat.indent.caseContents": true,
  "C_Cpp.vcFormat.space.aroundBinaryOperator": "insert",
  "C_Cpp.vcFormat.space.aroundAssignmentOperator": "insert",
  "C_Cpp.vcFormat.space.removeBeforeSemicolon": true,
  "C_Cpp.vcFormat.space.insertAfterSemicolon": false,
  "C_Cpp.vcFormat.space.pointerReferenceAlignment": "left",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.autoIndent": "full",
    "editor.trimAutoWhitespace": false,
    "editor.autoClosingBrackets": "languageDefined",
    "editor.autoClosingQuotes": "languageDefined",
    "editor.autoSurround": "languageDefined",
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 4,
    "editor.indentSize": 4,
    "editor.insertSpaces": true
  }
}
